# Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase server-side API routes
# Required by /api/jan-product, /api/kaitorix and /api/thumbnail.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Kaitorix product / buyback lookup
# Optional. Comma-separated tokens; the product-name lookup uses the first token.
KAITORIX_API_TOKENS=your_token1,your_token2
NEXT_PUBLIC_KAITORIX_RATE_LIMIT_MODE=ultra-safe

# Kaitorix Open API (price refresh /api/kaitorix/*; also used for the daily CSV download)
# The daily request limit is read from the API response headers; this is only the fallback
# before the first response (Premium plan = 500).
KAITORIX_OPEN_API_KEY=your_open_api_key
KAITORIX_OPEN_API_DAILY_LIMIT=500

# Daily catalog sync (/api/kaitorix/catalog-sync, triggered by Vercel Cron in vercel.json).
# Requires the Kaitorix "data download" add-on. Set the same value in Vercel env vars;
# Cron calls send it automatically as Authorization: Bearer.
CRON_SECRET=your_random_secret
